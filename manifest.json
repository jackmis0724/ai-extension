{
  "manifest_version": 3,
  "name": "AI网页助手",
  "version": "1.0",
  "permissions": [
    "sidePanel",
    "tabs", 
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "点击打开AI助手"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html"
}
# ====== AI 网页助手 后端配置 ======
# 复制此文件为 .env 并填入你的配置

# 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# AI 模型 API Keys（至少填一个）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# 默认模型（openai / deepseek / claude）
DEFAULT_MODEL=openai

# 认证密钥（生产环境请修改）
SECRET_KEY=change-me-in-production

# 速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# 上传文件大小限制（字节，默认10MB）
MAX_UPLOAD_SIZE=10485760

# 上传文件过期清理时间（小时，默认24小时）
UPLOAD_EXPIRY_HOURS=24

# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=chrome-extension://*,moz-extension://*
